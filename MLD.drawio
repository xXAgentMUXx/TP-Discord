        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\n%%{init: {\n  \&quot;theme\&quot;: \&quot;base\&quot;,\n  \&quot;themeVariables\&quot;: {\n    \&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;,\n    \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;,\n    \&quot;lineColor\&quot;: \&quot;#000000\&quot;,\n    \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;background\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;mainBkg\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;nodeBorder\&quot;: \&quot;#000000\&quot;,\n    \&quot;fontFamily\&quot;: \&quot;Arial\&quot;\n  }\n}}%%\n\nerDiagram\n\n    UTILISATEUR {\n        BIGINT id_utilisateur PK\n        VARCHAR pseudo\n        VARCHAR email UK\n    }\n\n    SERVEUR {\n        BIGINT id_serveur PK\n        VARCHAR nom\n        TIMESTAMP date_creation\n    }\n\n    APPARTENANCE {\n        BIGINT id_utilisateur PK, FK\n        BIGINT id_serveur PK, FK\n        VARCHAR role\n        TIMESTAMP date_adhesion\n    }\n\n    SALON {\n        BIGINT id_salon PK\n        BIGINT id_serveur FK\n        VARCHAR nom\n        VARCHAR type\n    }\n\n    MESSAGE {\n        BIGINT id_message PK\n        BIGINT id_salon FK\n        BIGINT id_auteur FK\n        TEXT contenu\n        TIMESTAMP date_envoi\n        TIMESTAMP date_modification\n    }\n\n    PIECE_JOINTE {\n        BIGINT id_piece_jointe PK\n        BIGINT id_message FK\n        VARCHAR type\n        TEXT emplacement\n        JSONB metadonnees\n    }\n\n    AMITIE {\n        BIGINT id_utilisateur_1 PK, FK\n        BIGINT id_utilisateur_2 PK, FK\n        TIMESTAMP date_creation\n    }\n\n    UTILISATEUR ||--o{ APPARTENANCE : id_utilisateur\n    SERVEUR ||--|{ APPARTENANCE : id_serveur\n\n    SERVEUR ||--|{ SALON : id_serveur\n\n    UTILISATEUR ||--o{ MESSAGE : id_auteur\n    SALON ||--o{ MESSAGE : id_salon\n\n    MESSAGE ||--o{ PIECE_JOINTE : id_message\n\n    UTILISATEUR ||--o{ AMITIE : id_utilisateur_1\n    UTILISATEUR ||--o{ AMITIE : id_utilisateur_2\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="OQ2jvekuXACM0leKop1Z-129">
